# Comma-separated list of absolute directories the backend is allowed to
# browse (/api/filesystem/*) and inspect/execute projects from
# (/api/projects/inspect). Optional: with no value, those endpoints accept
# any path reachable from this machine (unrestricted) — fine for local
# development, but set this before exposing the backend beyond your own
# machine.
#
# Example:
# ALLOWED_PROJECT_ROOTS=/Users/me/projects,/Users/me/work
ALLOWED_PROJECT_ROOTS=

# Host/port the Fastify server binds to. Defaults shown below.
HOST=127.0.0.1
PORT=8080

# Frontend base URL used for post-verification redirects.
FRONTEND_URL=http://127.0.0.1:5173

# Optional real email delivery via Resend.
# If these are missing, the backend falls back to the local dev mailbox.
RESEND_API_KEY=
EMAIL_FROM=
